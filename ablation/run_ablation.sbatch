#!/bin/bash
# SLURM array job: run final-scoring once per row in the ablation manifest.
# The manifest is generated by ablation/generate_samples.py.
#
# Required env vars (set when invoking sbatch):
#   MANIFEST            absolute path to manifest.tsv
#   NOTES               -n input
#   RATINGS             -r input
#   STATUS              -s input
#   ENROLLMENT          -e input
#   PRESCORING_INDIR    shared prescoring-output dir (reused by every array task)
#   COMMUNITYNOTES_DIR  path to the communitynotes repo (e.g. /orcd/home/002/jnallen/communitynotes)
#
# Launch (after generate_samples.py has produced manifest.tsv):
#   NLINES=$(($(wc -l < "$MANIFEST") - 1))
#   sbatch --array=0-$((NLINES-1))%20 ablation/run_ablation.sbatch

#SBATCH --job-name=cn-ablation
#SBATCH --output=logs/ablation_%A_%a.out
#SBATCH --error=logs/ablation_%A_%a.err
#SBATCH --time=02:00:00
#SBATCH --mem=64G
#SBATCH --cpus-per-task=12
# TODO: fill in cluster-specific knobs as needed
# #SBATCH --partition=
# #SBATCH --account=

set -euo pipefail
mkdir -p logs

: "${MANIFEST:?must set MANIFEST}"
: "${NOTES:?must set NOTES}"
: "${RATINGS:?must set RATINGS}"
: "${STATUS:?must set STATUS}"
: "${ENROLLMENT:?must set ENROLLMENT}"
: "${PRESCORING_INDIR:?must set PRESCORING_INDIR}"
: "${COMMUNITYNOTES_DIR:?must set COMMUNITYNOTES_DIR}"

ROW=$(awk -v i="$SLURM_ARRAY_TASK_ID" -F'\t' 'NR>1 && $1==i {print; exit}' "$MANIFEST")
if [[ -z "$ROW" ]]; then
  echo "no manifest row for array_idx=$SLURM_ARRAY_TASK_ID" >&2
  exit 2
fi

STRATEGY=$(echo "$ROW" | cut -f2)
PCT=$(echo "$ROW" | cut -f3)
SEED=$(echo "$ROW" | cut -f5)
NUM_KEPT=$(echo "$ROW" | cut -f6)
IDS_PATH=$(echo "$ROW" | cut -f7)
OUTPUT_DIR=$(echo "$ROW" | cut -f8)

echo "[$(date)] array_idx=$SLURM_ARRAY_TASK_ID strategy=$STRATEGY pct=$PCT seed=$SEED num_kept=$NUM_KEPT"
echo "  ids:    $IDS_PATH"
echo "  output: $OUTPUT_DIR"
mkdir -p "$OUTPUT_DIR"

cd "$COMMUNITYNOTES_DIR"
python -m sourcecode.main \
  -n "$NOTES" \
  -r "$RATINGS" \
  -s "$STATUS" \
  -e "$ENROLLMENT" \
  --prescoring-indir "$PRESCORING_INDIR" \
  --keep-participant-ids "$IDS_PATH" \
  -o "$OUTPUT_DIR" \
  --nostrict-columns
